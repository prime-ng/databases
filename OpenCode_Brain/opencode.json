{
  "$schema": "https://opencode.ai/config.json",
  "skills": ["./.opencode/skills"],
  "permissions": [
    { "action": "edit", "resource": "**/.env", "effect": "deny" },
    { "action": "edit", "resource": "**/.env.*", "effect": "deny" }
  ],
  "permission": {
    "external_directory": {
      "*": "allow"
    }
  }
}
